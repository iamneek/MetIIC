# --- Required ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Optional branding ---
VITE_APP_NAME=Campus Connect

# Comma-separated list of STUN/TURN servers. Public WebRTC STUN servers used by default.
# NOTE: STUN alone cannot guarantee connectivity behind restrictive NATs.
# Example: VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN configuration (leave empty to run STUN-only).
# WARNING: Never embed long-lived secret credentials here for production.
# Prefer short-lived credentials fetched at runtime from a trusted endpoint.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# "all" or "relay" — use "relay" to force TURN-only testing.
VITE_ICE_TRANSPORT_POLICY=all

# Seconds before a call is considered failed.
VITE_CONNECTION_TIMEOUT_MS=20000
